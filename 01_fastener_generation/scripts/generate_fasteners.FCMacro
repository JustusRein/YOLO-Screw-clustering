# -*- coding: utf-8 -*-

import FreeCAD as App
import Part
import Mesh
import csv
import os
import traceback
import re

import FastenersCmd


# ============================================================
# CONFIGURATION
# ============================================================

INPUT_CSV = "/data/input/fasteners.csv"

OUTPUT_DIR = "/data/output"

STL_DIR = os.path.join(OUTPUT_DIR, "stl")
STEP_DIR = os.path.join(OUTPUT_DIR, "step")
FCSTD_DIR = os.path.join(OUTPUT_DIR, "fcstd")

METADATA_FILE = os.path.join(
    OUTPUT_DIR,
    "generated_metadata.csv"
)

LOG_FILE = os.path.join(
    OUTPUT_DIR,
    "generation_log.txt"
)

THREAD_ENABLED = False

# The generator uses simple threads by default.
# This keeps the CAD generation and STL export relatively fast.

EXPORT_STL = True
EXPORT_STEP = True
SAVE_FCSTD = True


# ============================================================
# SUPPORTED FASTENER TYPES
# ============================================================

SUPPORTED_TYPES = {

    # Screws
    "ISO4017": "screw",
    "ISO4762": "screw",
    "ISO7046": "screw",
    "ISO7045": "screw",

    # Nuts
    "ISO4032": "nut",
    "DIN985": "nut",
    "DIN315": "nut",

    # Washers
    "ISO7089": "washer",
    "ISO7092": "washer",
    "ISO7093-1": "washer",
}


# ============================================================
# DIRECTORY SETUP
# ============================================================

for directory in [
    OUTPUT_DIR,
    STL_DIR,
    STEP_DIR,
    FCSTD_DIR
]:
    os.makedirs(directory, exist_ok=True)


# ============================================================
# LOGGING
# ============================================================

def log(message):

    message = str(message)

    print(message)

    with open(
        LOG_FILE,
        "a",
        encoding="utf-8"
    ) as file:

        file.write(message + "\n")


# ============================================================
# HELPERS
# ============================================================

def safe_filename(value):

    value = str(value).strip()

    value = re.sub(
        r"[^a-zA-Z0-9_-]+",
        "_",
        value
    )

    return value.strip("_")


def read_csv():

    if not os.path.exists(INPUT_CSV):

        raise FileNotFoundError(
            "Input CSV not found: {}".format(INPUT_CSV)
        )

    rows = []

    with open(
        INPUT_CSV,
        "r",
        encoding="utf-8-sig",
        newline=""
    ) as file:

        reader = csv.DictReader(file)

        required_columns = [
            "id",
            "fastener_type",
            "diameter"
        ]

        for column in required_columns:

            if column not in reader.fieldnames:

                raise ValueError(
                    "Missing CSV column: {}".format(column)
                )

        for row in reader:

            rows.append(row)

    return rows


def get_csv_value(row, key, default=""):

    value = row.get(key, default)

    if value is None:
        return default

    return str(value).strip()


def get_fastener_category(row):

    category = get_csv_value(
        row,
        "part_category"
    ).lower()

    if category:
        return category

    fastener_type = get_csv_value(
        row,
        "fastener_type"
    )

    return SUPPORTED_TYPES.get(
        fastener_type,
        "unknown"
    )


def get_part_type(row):

    part_type = get_csv_value(
        row,
        "part_type"
    )

    if part_type:
        return part_type

    return safe_filename(
        get_csv_value(row, "screw_type", "unknown")
    ).lower()


def get_available_diameters(obj):

    values = obj.getEnumerationsOfProperty(
        "Diameter"
    )

    return list(values)


def get_available_lengths(obj):

    if not hasattr(obj, "Length"):

        return []

    return list(
        obj.getEnumerationsOfProperty("Length")
    )


def set_diameter(obj, requested_diameter):

    available = get_available_diameters(obj)

    if requested_diameter not in available:

        raise ValueError(
            "Diameter {} is not supported. Available: {}".format(
                requested_diameter,
                available
            )
        )

    obj.Diameter = requested_diameter


def set_length(obj, requested_length):

    if not hasattr(obj, "Length"):

        return

    if not requested_length:

        raise ValueError(
            "Length is required for this fastener."
        )

    available = get_available_lengths(obj)

    requested_length = str(
        requested_length
    ).strip()

    if requested_length in available:

        obj.Length = requested_length

        return

    if "Custom" not in available:

        raise ValueError(
            "Length {} is not supported. Available: {}".format(
                requested_length,
                available
            )
        )

    obj.Length = "Custom"

    obj.LengthCustom = App.Units.Quantity(
        "{} mm".format(requested_length)
    )


# ============================================================
# CREATE FASTENER
# ============================================================

def create_fastener(row):

    fastener_id = get_csv_value(
        row,
        "id"
    )

    fastener_type = get_csv_value(
        row,
        "fastener_type"
    )

    diameter = get_csv_value(
        row,
        "diameter"
    )

    length = get_csv_value(
        row,
        "length_mm"
    )

    category = get_fastener_category(row)

    part_type = get_part_type(row)

    if fastener_type not in SUPPORTED_TYPES:

        raise ValueError(
            "Unsupported fastener type: {}".format(
                fastener_type
            )
        )

    if SUPPORTED_TYPES[fastener_type] != category:

        raise ValueError(
            "Category mismatch: {} is registered as {}, not {}".format(
                fastener_type,
                SUPPORTED_TYPES[fastener_type],
                category
            )
        )

    if category not in [
        "screw",
        "nut",
        "washer"
    ]:

        raise ValueError(
            "Unsupported category: {}".format(category)
        )

    name = "{}_{}_{}".format(
        fastener_id,
        part_type,
        diameter
    )

    if length:
        name += "_L{}".format(length)

    name = safe_filename(name)

    log("")
    log("=" * 60)
    log("Generating: {}".format(name))
    log("Category: {}".format(category))
    log("Standard: {}".format(fastener_type))
    log("Diameter: {}".format(diameter))
    log("Length: {}".format(length or "N/A"))

    # --------------------------------------------------------
    # Create FreeCAD document
    # --------------------------------------------------------

    doc = App.newDocument(name)

    try:

        obj = doc.addObject(
            "Part::FeaturePython",
            "Fastener"
        )

        # The same generic Fasteners Workbench object class
        # is used for screws, nuts and washers.
        #
        # The standard identifier determines the geometry
        # and the available parameters.

        FastenersCmd.FSScrewObject(
            obj,
            fastener_type,
            None
        )

        # ----------------------------------------------------
        # Diameter
        # ----------------------------------------------------

        set_diameter(
            obj,
            diameter
        )

        # ----------------------------------------------------
        # Length
        # Only screws have a length parameter in this setup.
        # ----------------------------------------------------

        if category == "screw":

            set_length(
                obj,
                length
            )

        # ----------------------------------------------------
        # Thread
        # ----------------------------------------------------

        if hasattr(obj, "Thread"):

            obj.Thread = THREAD_ENABLED

        # ----------------------------------------------------
        # Label
        # ----------------------------------------------------

        obj.Label = name

        # ----------------------------------------------------
        # Recompute geometry
        # ----------------------------------------------------

        doc.recompute()

        if not hasattr(obj, "Shape"):

            raise RuntimeError(
                "Generated object has no Shape property."
            )

        if obj.Shape.isNull():

            raise RuntimeError(
                "Generated shape is empty."
            )

        if not obj.Shape.isValid():

            raise RuntimeError(
                "Generated shape is invalid."
            )

        # ----------------------------------------------------
        # Export STL
        # ----------------------------------------------------

        stl_filename = name + ".stl"

        stl_path = os.path.join(
            STL_DIR,
            stl_filename
        )

        if EXPORT_STL:

            Mesh.export(
                [obj],
                stl_path
            )

            if not os.path.exists(stl_path):

                raise RuntimeError(
                    "STL export failed."
                )

            log("STL exported: {}".format(stl_path))

        # ----------------------------------------------------
        # Export STEP
        # ----------------------------------------------------

        step_filename = name + ".step"

        step_path = os.path.join(
            STEP_DIR,
            step_filename
        )

        if EXPORT_STEP:

            Part.export(
                [obj],
                step_path
            )

            if not os.path.exists(step_path):

                raise RuntimeError(
                    "STEP export failed."
                )

            log("STEP exported: {}".format(step_path))

        # ----------------------------------------------------
        # Save FCStd
        # ----------------------------------------------------

        fcstd_filename = name + ".FCStd"

        fcstd_path = os.path.join(
            FCSTD_DIR,
            fcstd_filename
        )

        if SAVE_FCSTD:

            doc.recompute()

            doc.saveAs(
                fcstd_path
            )

            log("FCStd saved: {}".format(fcstd_path))

        # ----------------------------------------------------
        # Metadata
        # ----------------------------------------------------

        metadata = {

            "id": fastener_id,

            "filename": stl_filename,

            "stl_file": stl_filename,

            "part_category": category,

            "part_type": part_type,

            "standard": fastener_type,

            "fastener_type": fastener_type,

            "screw_type": get_csv_value(
                row,
                "screw_type",
                part_type
            ),

            "diameter": diameter,

            "length_mm": length,

            "thread_type": get_csv_value(
                row,
                "thread_type",
                "simple"
            ),

            "tool_size": get_csv_value(
                row,
                "tool_size"
            ),

            "thread_size": get_csv_value(
                row,
                "thread_size",
                diameter
            ),

            "thread_pitch": get_csv_value(
                row,
                "thread_pitch"
            ),

            "screw_length": get_csv_value(
                row,
                "screw_length"
            ),

            "generation_status": "success"

        }

        return metadata

    finally:

        App.closeDocument(doc.Name)


# ============================================================
# MAIN
# ============================================================

def main():

    log("")
    log("=" * 60)
    log("FREECAD FASTENER GENERATOR")
    log("=" * 60)

    rows = read_csv()

    log(
        "Input entries: {}".format(len(rows))
    )

    metadata_rows = []

    successful = 0
    failed = 0

    for row in rows:

        try:

            metadata = create_fastener(row)

            metadata_rows.append(metadata)

            successful += 1

            log(
                "SUCCESS: {}".format(
                    metadata["filename"]
                )
            )

        except Exception as error:

            failed += 1

            log(
                "ERROR for ID {}: {}".format(
                    get_csv_value(row, "id"),
                    error
                )
            )

            log(
                traceback.format_exc()
            )

            metadata_rows.append({

                "id": get_csv_value(row, "id"),

                "filename": "",

                "stl_file": "",

                "part_category": get_csv_value(
                    row,
                    "part_category"
                ),

                "part_type": get_csv_value(
                    row,
                    "part_type"
                ),

                "standard": get_csv_value(
                    row,
                    "standard"
                ),

                "fastener_type": get_csv_value(
                    row,
                    "fastener_type"
                ),

                "diameter": get_csv_value(
                    row,
                    "diameter"
                ),

                "length_mm": get_csv_value(
                    row,
                    "length_mm"
                ),

                "generation_status": "failed"

            })

    # --------------------------------------------------------
    # Write metadata CSV
    # --------------------------------------------------------

    fieldnames = [

        "id",
        "filename",
        "stl_file",

        "part_category",
        "part_type",

        "standard",
        "fastener_type",

        "screw_type",

        "diameter",
        "length_mm",

        "thread_type",
        "tool_size",
        "thread_size",
        "thread_pitch",
        "screw_length",

        "generation_status"

    ]

    with open(
        METADATA_FILE,
        "w",
        encoding="utf-8",
        newline=""
    ) as file:

        writer = csv.DictWriter(
            file,
            fieldnames=fieldnames,
            extrasaction="ignore"
        )

        writer.writeheader()

        writer.writerows(metadata_rows)

    # --------------------------------------------------------
    # Summary
    # --------------------------------------------------------

    log("")
    log("=" * 60)
    log("GENERATION FINISHED")
    log("=" * 60)

    log(
        "Successful: {}".format(successful)
    )

    log(
        "Failed: {}".format(failed)
    )

    log(
        "Total: {}".format(len(rows))
    )

    log(
        "Metadata: {}".format(METADATA_FILE)
    )

    log("=" * 60)


# ============================================================
# RUN
# ============================================================

main()